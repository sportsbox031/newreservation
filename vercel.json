{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/daily-notifications",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 0 */5 * *"
    }
  ]
}
